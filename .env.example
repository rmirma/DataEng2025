# ==============================================
# AIRFLOW CONFIGURATION
# ==============================================

# Airflow PostgreSQL Database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
PGUSER=airflow
PGPASSWORD=airflow
PGDATABASE=airflow

# Airflow Credentials (for web UI login)
AIRFLOW_DB_USER=admin
AIRFLOW_DB_PASSWORD=admin

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here
AIRFLOW__WEBSERVER__WTF_CSRF_ENABLED=False

# ==============================================
# PGADMIN CONFIGURATION
# ==============================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
CSRF_ENABLED=False

# ==============================================
# CLICKHOUSE CONFIGURATION
# ==============================================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# ==============================================
# OPENMETADATA CONFIGURATION
# ==============================================

# MySQL for OpenMetadata
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=openmetadata_db
MYSQL_USER=openmetadata_user
MYSQL_PASSWORD=openmetadata_password

# OpenMetadata Database Connection
DB_HOST=mysql
DB_PORT=3306
DB_USER=openmetadata_user
DB_PASSWORD=openmetadata_password
DB_NAME=openmetadata_db

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# OpenMetadata Fernet Key
FERNET_KEY=jJ/9sz0g0OHxsfxOoSfdFdmk3ysNmPRnH3TUAbz3IHA=

