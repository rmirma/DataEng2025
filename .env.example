# Airflow PostgreSQL Database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
PGUSER=airflow
PGPASSWORD=airflow
PGDATABASE=airflow

# Airflow Credentials
