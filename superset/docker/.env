# Superset Configuration
PYTHONUNBUFFERED=1
COMPOSE_PROJECT_NAME=superset
DEV_MODE=true
ADMIN_PASSWORD=admin

# Database configurations for Superset metadata
DATABASE_DB=superset
DATABASE_HOST=superset-db
DATABASE_PASSWORD=superset
